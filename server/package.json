{
  "name": "actinvent-server",
  "version": "1.0.0",
  "description": "Backend API y monolito modular para actinvent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/docs && cp src/docs/openapi.json dist/docs/",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test --test-concurrency=1 src/tests/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
